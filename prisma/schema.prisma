// Fanzonstore admin backend — Postgres via Prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum OrderStatus {
  PAYMENT_PENDING
  PAYMENT_FAILED
  PENDING // created in our store, not yet sent to production
  ON_HOLD // created in Printify, awaiting review
  IN_PRODUCTION
  FULFILLED
  CANCELED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id                      String      @id @default(cuid())
  /// external id we send to Printify (fanzonstore-<ts>)
  externalId              String      @unique
  /// Printify order id once created
  printifyOrderId         String?     @unique
  /// Stripe Checkout Session id for card payment
  stripeCheckoutSessionId String?     @unique
  /// Stripe PaymentIntent id once payment succeeds
  stripePaymentIntentId   String?     @unique
  paidAt                  DateTime?
  status                  OrderStatus @default(PENDING)

  // customer / shipping snapshot
  email     String
  firstName String
  lastName  String
  phone     String?
  country   String
  region    String?
  address1  String
  address2  String?
  city      String
  zip       String

  subtotal Int // cents
  shipping Int    @default(0) // cents
  total    Int // cents
  currency String @default("USD")

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  productId String // Printify product id
  variantId String // Printify variant id
  name      String
  image     String
  size      String
  color     String
  qty       Int
  price     Int // unit price in cents

  /// When this item is one component of a purchased bundle, the Bundle.id and the
  /// component label ("Dad"/"Kid") so the two fulfillment rows can be grouped as
  /// one set in admin. Null for normal single-product items.
  bundleId    String?
  bundleLabel String?

  @@index([orderId])
}

/// A storefront bundle: ONE product the shopper buys at a fixed set price, made
/// of 2+ separate Printify products fulfilled as multiple line items in one
/// order. Components reference live Printify products (not stored in the DB);
/// only the bundle's own marketing + pricing live here.
model Bundle {
  id             String            @id @default(cuid())
  slug           String            @unique
  name           String
  description    String
  price          Int // FIXED set price in cents (authoritative)
  compareAtPrice Int? // "was" price in cents
  image          String // hero image URL
  badge          String?
  category       String
  active         Boolean           @default(true)
  components     BundleComponent[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([active])
}

model BundleComponent {
  id              String   @id @default(cuid())
  bundle          Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  bundleId        String
  productId       String // Printify product id of the component shirt
  label           String // "Dad" / "Kid"
  sortOrder       Int      @default(0)
  lockedVariantId Int? // optional: force a specific Printify variant (no customer choice)
  allowedColors   String? // optional CSV of color names to restrict the picker
  createdAt       DateTime @default(now())

  @@index([bundleId])
}
