// Fanzonstore admin backend — Postgres via Prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING // created in our store, not yet sent to production
  ON_HOLD // created in Printify, awaiting review
  IN_PRODUCTION
  FULFILLED
  CANCELED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  /// external id we send to Printify (fanzonstore-<ts>)
  externalId      String      @unique
  /// Printify order id once created
  printifyOrderId String?     @unique
  status          OrderStatus @default(PENDING)

  // customer / shipping snapshot
  email      String
  firstName  String
  lastName   String
  phone      String?
  country    String
  region     String?
  address1   String
  address2   String?
  city       String
  zip        String

  subtotal   Int // cents
  shipping   Int    @default(0) // cents
  total      Int // cents
  currency   String @default("USD")

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  productId String // Printify product id
  variantId String // Printify variant id
  name      String
  image     String
  size      String
  color     String
  qty       Int
  price     Int // unit price in cents

  @@index([orderId])
}
